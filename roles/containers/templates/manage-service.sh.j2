#!/bin/bash
# Wrapper to manage the user systemd service for {{ container.name }}
ACTION=$1

if [[ ! "$ACTION" =~ ^(start|stop|restart|status)$ ]]; then
    echo "Usage: sudo -u svc-{{ container.name }} $0 {start|stop|restart|status}"
    exit 1
fi

export XDG_RUNTIME_DIR="/run/user/{{ _container_user.uid }}"

/usr/bin/systemctl --user "$ACTION" "{{ container.name }}.service"