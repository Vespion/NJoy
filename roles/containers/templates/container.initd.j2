#!/sbin/openrc-run

name="{{ item.name }}"
description="GitOps Managed Rootless Podman Container - {{ item.name }}"
run_user="{{ user_podsvc.name }}"
pidfile="/home/${run_user}/${name}.pid"

command="/usr/bin/podman"

# Base run arguments
command_args="run -d --rm --name ${name} --conmon-pidfile ${pidfile}"

# Dynamically append Volume bindings
{% if item.volumes is defined %}
{% for vol in item.volumes %}
command_args="${command_args} -v {{ vol }}"
{% endfor %}
{% endif %}

# Dynamically append Port bindings
{% if item.ports is defined %}
{% for port in item.ports %}
command_args="${command_args} -p {{ port }}"
{% endfor %}
{% endif %}

# Append the image and optional execution command
command_args="${command_args} {{ item.image }} {% if item.command is defined %}{{ item.command }}{% endif %}"

command_user="${run_user}:${run_user}"
command_env="XDG_RUNTIME_DIR=/tmp/${run_user}-runtime"

depend() {
    need net cgroups
}

start_pre() {
    checkpath -d -m 0700 -o ${run_user}:${run_user} /tmp/${run_user}-runtime
}

start() {
    ebegin "Starting ${name}"
    
    if /sbin/start-stop-daemon --start \
        --pidfile "${pidfile}" \
        --user "${command_user}" \
        --env "${command_env}" \
        --exec "${command}" \
        -- ${command_args}; then
        
        {% if item.ports is defined and item.ports|length > 0 %}
        # Add firewalld permanent rules and reload runtime state
        {% for p in item.ports %}
        {% set parts = p.split('/') %}
        {% set proto = parts[1] if parts|length > 1 else 'tcp' %}
        {% set ip_port_parts = parts[0].split(':') %}
        {% if ip_port_parts|length == 3 %}
            {% set host_port = ip_port_parts[1] %}
        {% else %}
            {% set host_port = ip_port_parts[0] %}
        {% endif %}
        firewall-cmd --zone=public --add-port={{ host_port }}/{{ proto }} --permanent >/dev/null 2>&1
        {% endfor %}
        firewall-cmd --reload >/dev/null 2>&1
        {% endif %}
        eend 0
    else
        eend 1
    fi
}

stop() {
    ebegin "Stopping ${name} (Timeout: 20s)"
    
    XDG_RUNTIME_DIR=/tmp/${run_user}-runtime su - ${run_user} -c "podman stop -t 20 ${name} || podman rm -f ${name}"
    
    {% if item.ports is defined and item.ports|length > 0 %}
    # Remove firewalld permanent rules and reload runtime state
    {% for p in item.ports %}
    {% set parts = p.split('/') %}
    {% set proto = parts[1] if parts|length > 1 else 'tcp' %}
    {% set ip_port_parts = parts[0].split(':') %}
    {% if ip_port_parts|length == 3 %}
        {% set host_port = ip_port_parts[1] %}
    {% else %}
        {% set host_port = ip_port_parts[0] %}
    {% endif %}
    firewall-cmd --zone=public --remove-port={{ host_port }}/{{ proto }} --permanent >/dev/null 2>&1
    {% endfor %}
    firewall-cmd --reload >/dev/null 2>&1
    {% endif %}
    
    rm -f "${pidfile}"
    eend $?
}