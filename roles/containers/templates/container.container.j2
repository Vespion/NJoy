[Unit]
Description=Podman container for {{ container.name }}
After=network-online.target

[Container]
Image={{ container.image }}
# Checks if the registry image digest differs from the local image digest
AutoUpdate=registry
# Dynamically isolates the container into a unique, unprivileged namespace
UserNS=auto
{% if container.stop_timeout is defined %}
StopTimeout={{ container.stop_timeout }}
{% endif %}
{% if container.memory.max is defined %}
PodmanArgs=--memory={{ container.memory.max }}
{% endif %}
{% if container.memory.min is defined %}
PodmanArgs=--memory-reservation={{ container.memory.min }}
{% endif %}
{% for vol in container.volumes | default([]) %}
Volume={{ vol }}:Z
{% endfor %}
{% for port in container.ports | default([]) %}
PublishPort={{ port }}
{% endfor %}

[Service]
Restart=on-failure
{% if container.stop_timeout is defined %}
TimeoutStopSec={{ container.stop_timeout | int + 10 }}
{% endif %}
ExecStartPost=/usr/sbin/ufw route allow podman-{{ container.name }}
ExecStopPost=-/usr/sbin/ufw delete allow podman-{{ container.name }}
{% if container.memory.min is defined %}
MemoryMin={{ container.memory.min }}
{% endif %}
{% if container.memory.max is defined %}
MemoryHigh={{ container.memory.max }}
{% endif %}

[Install]
WantedBy=multi-user.target