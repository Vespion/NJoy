:CONNLIMIT - [0:0]
# Route new SYN packets on specified ports to the CONNLIMIT chain
{% for rule in fail2ban_protected_ports %}
-A ufw6-before-input -p tcp --syn --dport {{ rule.port }} -j CONNLIMIT
{% endfor %}

# Check how many concurrent connections each IPv6 address holds per port
{% for rule in fail2ban_protected_ports %}
# Rules for port {{ rule.port }}
-A CONNLIMIT -p tcp --dport {{ rule.port }} -m conntrack --ctstate NEW -m connlimit --connlimit-saddr --connlimit-above
{{ rule.connlimit | default(100) }} --connlimit-mask 128 -m limit --limit 1/min --limit-burst 1 -j LOG --log-prefix
"[UFW6 Connlimit {{ rule.port }}] "
-A CONNLIMIT -p tcp --dport {{ rule.port }} -m conntrack --ctstate NEW -m connlimit --connlimit-saddr --connlimit-above
{{ rule.connlimit | default(100) }} --connlimit-mask 128 -j DROP
{% endfor %}

# Below the limit → continue to SYN_FLOOD_PROTECTION
-A CONNLIMIT -j RETURN

:SYN_FLOOD_PROTECTION - [0:0]
# Route new SYN packets on specified ports to the SYN_FLOOD_PROTECTION chain
{% for rule in fail2ban_protected_ports %}
-A ufw6-before-input -p tcp --syn --dport {{ rule.port }} -j SYN_FLOOD_PROTECTION
{% endfor %}

# Track per-IP connection rates using unique hashlimit buckets per port
{% for rule in fail2ban_protected_ports %}
# Normal traffic for port {{ rule.port }} → allow immediately
-A SYN_FLOOD_PROTECTION -p tcp --dport {{ rule.port }} -m conntrack --ctstate NEW -m hashlimit --hashlimit-name
synlimit6_{{ rule.port }} --hashlimit-upto {{ rule.synlimit_rate | default('30/second') }} --hashlimit-burst {{
rule.synlimit_burst | default(60) }} --hashlimit-mode srcip --hashlimit-srcmask 128 -j RETURN

# Over the rate limit for port {{ rule.port }} → log once per minute, then drop
-A SYN_FLOOD_PROTECTION -p tcp --dport {{ rule.port }} -m conntrack --ctstate NEW -m hashlimit --hashlimit-name
synlimit6_{{ rule.port }} --hashlimit-above {{ rule.synlimit_rate | default('30/second') }} --hashlimit-burst {{
rule.synlimit_burst | default(60) }} --hashlimit-mode srcip --hashlimit-srcmask 128 -m limit --limit 1/minute
--limit-burst 1 -j LOG --log-prefix "[UFW6 SYN Flood {{ rule.port }}] "
-A SYN_FLOOD_PROTECTION -p tcp --dport {{ rule.port }} -m conntrack --ctstate NEW -m hashlimit --hashlimit-name
synlimit6_{{ rule.port }} --hashlimit-above {{ rule.synlimit_rate | default('30/second') }} --hashlimit-burst {{
rule.synlimit_burst | default(60) }} --hashlimit-mode srcip --hashlimit-srcmask 128 -j DROP
{% endfor %}

# Return to normal UFW processing
-A SYN_FLOOD_PROTECTION -j RETURN