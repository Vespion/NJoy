#!/usr/bin/env bash
set -euo pipefail

REPO_URL="${GITOPS_REPO_URL:-git@gitops:Vespion/NJoy.git}"
BRANCH="${GITOPS_BRANCH:-{{ gitops_branch }}}"
WORKDIR="${GITOPS_WORKDIR:-/var/lib/ansible-pull}"

# 1. Self-Locking Mechanism
# Replicates the inline flock by opening a file descriptor. 
# If the script exits or crashes, the descriptor closes and the lock is released natively.
exec 9> /run/ansible-pull.lock
if ! flock -n 9; then
  echo "INFO: Failed to acquire lock. Another GitOps instance is currently running."
  exit 0
fi

# 2. Replicate --accept-host-key
export GIT_SSH_COMMAND="ssh -o StrictHostKeyChecking=accept-new"

echo "INFO: Ensuring GitOps workspace exists at $WORKDIR..."
mkdir -p "$WORKDIR"

# 3. Git Operations (Replicating --clean and --only-if-changed)
if [ ! -d "$WORKDIR/.git" ]; then
    echo "INFO: Performing initial clone of $REPO_URL (branch: $BRANCH)..."
    git clone --branch "$BRANCH" "$REPO_URL" "$WORKDIR"
    cd "$WORKDIR"
    CHANGED=true
else
    echo "INFO: Fetching latest state for $REPO_URL..."
    cd "$WORKDIR"
    
    OLD_HEAD=$(git rev-parse HEAD)

    # Replicate --clean by wiping untracked files and forcing sync with origin
    git fetch origin "$BRANCH"
    git reset --hard "origin/$BRANCH"
    git clean -fdx

    NEW_HEAD=$(git rev-parse HEAD)

    if [ "$OLD_HEAD" != "$NEW_HEAD" ]; then
        CHANGED=true
        echo "INFO: Changes detected ($OLD_HEAD -> $NEW_HEAD)."
    else
        CHANGED=false
        echo "INFO: No repository changes detected."
    fi
fi

# 4. Replicate --only-if-changed logic
if [ "$CHANGED" = false ]; then
    echo "INFO: Exiting gracefully as no changes were detected in the GitOps repository."
    exit 0
fi

# 5. Install Dependencies
echo "INFO: Checking for Ansible dependencies..."
if [ -f "requirements.yml" ]; then
    echo "INFO: Installing from requirements.yml..."
    ansible-galaxy install -r requirements.yml
else
    echo "INFO: No requirements.yml found. Skipping galaxy installation."
fi

# 6. Playbook Resolution Logic (FQDN -> Short Hostname -> local.yml)
# Redirect stderr to /dev/null to prevent console spam if 'hostname -f' isn't supported on the OS
FQDN=$(hostname -f 2>/dev/null || echo "unknown-fqdn")
SHORT_HOST=$(hostname -s 2>/dev/null || hostname)

if [ -f "${FQDN}.yml" ]; then
    PLAYBOOK="${FQDN}.yml"
elif [ -f "${SHORT_HOST}.yml" ]; then
    PLAYBOOK="${SHORT_HOST}.yml"
elif [ -f "local.yml" ]; then
    PLAYBOOK="local.yml"
else
    echo "ERROR: Could not find ${FQDN}.yml, ${SHORT_HOST}.yml, or local.yml in the repository."
    exit 1
fi

# 7. Execute Resolved Playbook
echo "INFO: Resolved playbook target. Executing ${PLAYBOOK}..."
ansible-playbook "$PLAYBOOK"

echo "INFO: GitOps sync completed successfully."